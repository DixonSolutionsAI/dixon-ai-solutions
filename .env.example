OPENAI_API_KEY=your_openai_key_here
PILOT_ACCESS_CODE=use-a-long-random-private-code
# Optional; defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional Google Drive document integration; configure all values together.
COMPANY_DOCUMENT_OWNER_PASSWORD=use-a-different-long-random-owner-password
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_POLICY_FILE_ID=policy-text-file-id
GOOGLE_DRIVE_GUIDELINES_FILE_ID=guidelines-text-file-id
